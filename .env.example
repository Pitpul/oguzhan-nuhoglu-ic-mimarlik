# Ortam: development | production | test
NODE_ENV=development
PORT=3000

# Sitenin yayınlanacağı tam adres (canonical, sitemap ve Open Graph için). Sonunda "/" olmamalı.
BASE_URL=http://localhost:3000

# PostgreSQL bağlantısı (yerel veya Supabase)
# Yerel:    postgresql://KULLANICI:SIFRE@localhost:5432/VERITABANI
# Supabase: postgresql://postgres.[PROJE_REF]:[SIFRE]@aws-0-[BOLGE].pooler.supabase.com:6543/postgres
DATABASE_URL=

# Opsiyonel: SSL'i zorla (true) veya kapat (false). Boşsa Supabase adreslerinde otomatik açılır.
DB_SSL=

# Testler için ayrı bir veritabanı (opsiyonel; testler bu veritabanındaki tabloları temizler!)
TEST_DATABASE_URL=

# En az 32 karakter rastgele değer. Üretmek için: openssl rand -hex 32
SESSION_SECRET=

# İlk kurulumda admin yoksa oluşturulur (şifre en az 10 karakter). Mevcut admin şifresini değiştirmez.
ADMIN_USER=
ADMIN_PASS=

# Opsiyonel: Üretimde (Render.com) kalıcı görsel depolama için Supabase Storage ayarları
# Tanımlanmazsa yerel public/uploads/ klasörü kullanılır. Service Role anahtarı yalnızca sunucuda tutulur.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=project-images
