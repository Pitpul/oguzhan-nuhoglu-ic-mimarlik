{
  "name": "oguzhan-nuhoglu-ic-mimarlik",
  "version": "1.0.0",
  "description": "Oğuzhan Nuhoğlu İç Mimarlık - Kurumsal web sitesi, portfolyo yönetimi ve mini CRM (Node.js, Express, EJS, PostgreSQL)",
  "main": "server.js",
  "private": true,
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "build": "tailwindcss -i ./src/tailwind.css -o ./public/css/style.css --minify",
    "build:css": "npm run build",
    "watch:css": "tailwindcss -i ./src/tailwind.css -o ./public/css/style.css --watch",
    "test": "node --test --test-concurrency=1 tests/*.test.js"
  },
  "license": "UNLICENSED",
  "dependencies": {
    "bcrypt": "^5.1.1",
    "connect-pg-simple": "^10.0.0",
    "dotenv": "^16.4.5",
    "ejs": "^3.1.10",
    "express": "^4.21.1",
    "express-rate-limit": "^7.4.1",
    "express-session": "^1.18.1",
    "helmet": "^8.0.0",
    "multer": "^2.0.2",
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "supertest": "^7.0.0",
    "tailwindcss": "^3.4.17"
  }
}
