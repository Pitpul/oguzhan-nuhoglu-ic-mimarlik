<%- include('../partials/admin-header') %>
<%
  const W = ['w-0','w-[10%]','w-[20%]','w-[30%]','w-[40%]','w-[50%]','w-[60%]','w-[70%]','w-[80%]','w-[90%]','w-full'];
  const bar = (count, total) => W[total ? Math.round((count / total) * 10) : 0];
  const cards = [
    ['Toplam Proje', projectStats.total, '/admin/projeler'],
    ['Öne Çıkan Proje', projectStats.featured + ' / 3', '/admin/projeler'],
    ['Yeni Talepler', inquiryStats.newCount, '/admin/talepler?status=' + encodeURIComponent('Yeni Talep')],
    ['Devam Eden Görüşmeler', inquiryStats.ongoing, '/admin/talepler'],
    ['Tamamlanan İşler', inquiryStats.completed, '/admin/talepler?status=' + encodeURIComponent('Tamamlandı')]
  ];
%>
<div class="mb-8 flex flex-wrap items-end justify-between gap-4">
  <div>
    <p class="eyebrow">Genel Bakış</p>
    <h1 class="display mt-1 text-3xl sm:text-4xl">Dashboard</h1>
  </div>
  <div class="flex flex-wrap gap-3">
    <a href="/admin/projeler/yeni" class="btn btn-dark btn-sm">+ Yeni Proje</a>
    <a href="/admin/talepler" class="btn btn-outline btn-sm">Talepleri Yönet</a>
  </div>
</div>

<div class="grid grid-cols-2 gap-4 lg:grid-cols-5">
  <% cards.forEach((c) => { %>
    <a href="<%= c[2] %>" class="admin-card group transition-shadow hover:shadow-md <%= c[0] === 'Yeni Talepler' && inquiryStats.newCount > 0 ? 'ring-1 ring-bronze' : '' %>">
      <p class="text-[11px] font-medium uppercase tracking-wider text-muted"><%= c[0] %></p>
      <p class="mt-3 font-serif text-4xl font-light text-charcoal"><%= c[1] %></p>
    </a>
  <% }) %>
</div>

<div class="mt-6 grid gap-6 lg:grid-cols-2">
  <section class="admin-card" aria-labelledby="cat-title">
    <h2 id="cat-title" class="mb-5 font-serif text-2xl">Kategorilere Göre Projeler</h2>
    <ul class="space-y-4">
      <% categoryCounts.forEach((c) => { %>
        <li>
          <div class="mb-1.5 flex justify-between text-xs"><span class="text-muted"><%= c.label %></span><span class="font-medium"><%= c.count %></span></div>
          <div class="h-2 overflow-hidden rounded-full bg-ivory"><div class="h-full rounded-full bg-bronze <%= bar(c.count, projectStats.total) %>"></div></div>
        </li>
      <% }) %>
    </ul>
  </section>

  <section class="admin-card" aria-labelledby="status-title">
    <h2 id="status-title" class="mb-5 font-serif text-2xl">Talep Durumları <span class="text-sm text-muted">(<%= inquiryStats.total %>)</span></h2>
    <ul class="space-y-4">
      <% inquiryStatuses.forEach((s) => { %>
        <li>
          <div class="mb-1.5 flex justify-between text-xs"><span class="text-muted"><%= s %></span><span class="font-medium"><%= inquiryStats.counts[s] %></span></div>
          <div class="h-2 overflow-hidden rounded-full bg-ivory"><div class="h-full rounded-full bg-charcoal <%= bar(inquiryStats.counts[s], inquiryStats.total) %>"></div></div>
        </li>
      <% }) %>
    </ul>
  </section>
</div>

<section class="admin-card mt-6" aria-labelledby="recent-title">
  <div class="mb-5 flex items-center justify-between gap-4">
    <h2 id="recent-title" class="font-serif text-2xl">Son Talepler</h2>
    <a href="/admin/talepler" class="link-arrow">Tümü <span aria-hidden="true">→</span></a>
  </div>
  <% if (inquiryStats.recent.length) { %>
    <ul class="divide-y divide-charcoal/10">
      <% inquiryStats.recent.forEach((q) => { %>
        <li class="flex flex-wrap items-center justify-between gap-x-6 gap-y-1 py-3 text-sm">
          <div><p class="font-medium"><%= q.full_name %></p><p class="text-xs text-muted"><%= q.project_type %> • <%= formatDate(q.created_at) %></p></div>
          <span class="badge"><%= q.status %></span>
        </li>
      <% }) %>
    </ul>
  <% } else { %>
    <p class="py-6 text-center text-sm text-muted">Henüz müşteri talebi bulunmuyor.</p>
  <% } %>
</section>
<%- include('../partials/admin-footer') %>
