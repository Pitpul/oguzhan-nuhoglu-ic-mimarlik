<%- include('../partials/admin-header') %>
<%
  const p = project || {};
  const e = errors || {};
  const action = isEdit ? `/admin/projeler/${p.id}/guncelle` : '/admin/projeler';
  const inv = (k) => (e[k] ? 'aria-invalid="true"' : '');
  const err = (k) => (e[k] ? `<p class="field-error">${String(e[k]).replace(/&/g,'&amp;').replace(/</g,'&lt;')}</p>` : '');
  const featuredBlocked = !p.is_featured && featuredCount >= maxFeatured;
%>
<div class="mb-6">
  <a href="/admin/projeler" class="link-arrow">← Projelere Dön</a>
  <h1 class="display mt-3 text-3xl sm:text-4xl"><%= isEdit ? 'Projeyi Düzenle' : 'Yeni Proje Ekle' %></h1>
</div>

<% if (Object.keys(e).length) { %>
  <div class="mb-6 rounded-xl border border-red-700/30 bg-red-50 px-5 py-4 text-sm text-red-900" role="alert">Lütfen işaretli alanları kontrol edin.</div>
<% } %>

<form action="<%= action %>?_csrf=<%= csrfToken() %>" method="post" enctype="multipart/form-data" class="admin-card grid gap-5 lg:grid-cols-2" novalidate>
  <div class="lg:col-span-2">
    <label class="label" for="title">Proje Başlığı *</label>
    <input class="field" id="title" name="title" type="text" required maxlength="150" value="<%= p.title || '' %>" <%- inv('title') %>>
    <%- err('title') %>
  </div>

  <div>
    <label class="label" for="category">Kategori *</label>
    <select class="field" id="category" name="category" required <%- inv('category') %>>
      <% projectCategories.forEach((c) => { %><option value="<%= c.value %>" <%= p.category === c.value ? 'selected' : '' %>><%= c.label %></option><% }) %>
    </select>
    <%- err('category') %>
  </div>
  <div>
    <label class="label" for="location">Lokasyon *</label>
    <input class="field" id="location" name="location" type="text" required maxlength="255" placeholder="Örn. Yalıkavak, Bodrum" value="<%= p.location || '' %>" <%- inv('location') %>>
    <%- err('location') %>
  </div>
  <div>
    <label class="label" for="area">Alan (m²) *</label>
    <input class="field" id="area" name="area" type="text" required maxlength="100" placeholder="Örn. 450 m²" value="<%= p.area || '' %>" <%- inv('area') %>>
    <%- err('area') %>
  </div>
  <div>
    <label class="label" for="year">Yıl *</label>
    <input class="field" id="year" name="year" type="text" inputmode="numeric" required maxlength="4" placeholder="2025" value="<%= p.year || '' %>" <%- inv('year') %>>
    <%- err('year') %>
  </div>

  <div class="lg:col-span-2">
    <label class="label" for="description">Açıklama *</label>
    <textarea class="field resize-y" id="description" name="description" rows="5" required maxlength="5000" <%- inv('description') %>><%= p.description || '' %></textarea>
    <%- err('description') %>
  </div>
  <div>
    <label class="label" for="materials">Malzemeler (virgülle ayırın)</label>
    <textarea class="field resize-y" id="materials" name="materials" rows="3" maxlength="2000" <%- inv('materials') %>><%= p.materials || '' %></textarea>
    <%- err('materials') %>
  </div>
  <div>
    <label class="label" for="architect">Mimari Ekip</label>
    <input class="field" id="architect" name="architect" type="text" maxlength="255" placeholder="Boş bırakılırsa stüdyo adı kullanılır" value="<%= p.architect || '' %>" <%- inv('architect') %>>
    <%- err('architect') %>
  </div>

  <fieldset class="rounded-xl border border-charcoal/10 p-5 lg:col-span-2">
    <legend class="px-2 text-[11px] font-medium uppercase tracking-wider text-muted">Proje Görseli</legend>
    <div class="grid gap-5 lg:grid-cols-[14rem_1fr]">
      <div class="aspect-[4/3] overflow-hidden rounded-xl border border-charcoal/10 bg-ivory">
        <img id="image-preview" src="<%= p.image_url || '' %>" alt="Görsel önizleme" class="<%= p.image_url ? '' : 'hidden ' %>h-full w-full object-cover">
      </div>
      <div class="space-y-4">
        <div>
          <label class="label" for="image_file">Dosya Yükle (JPG, PNG, WEBP — en fazla 5 MB)</label>
          <input class="field file:mr-4 file:rounded-full file:border-0 file:bg-charcoal file:px-4 file:py-2 file:text-xs file:text-bone" id="image_file" name="image_file" type="file" accept="image/jpeg,image/png,image/webp" <%- inv('image_file') %>>
          <%- err('image_file') %>
        </div>
        <div>
          <label class="label" for="image_url">veya Görsel URL</label>
          <input class="field" id="image_url" name="image_url" type="url" maxlength="2000" placeholder="https://..." value="<%= p.image_url && !p.image_url.startsWith('/uploads/') ? p.image_url : '' %>" <%- inv('image_url') %>>
          <%- err('image_url') %>
          <p class="mt-1.5 text-xs text-muted">Dosya yüklerseniz URL yerine yüklenen dosya kullanılır. <%= isEdit ? 'Hiçbirini değiştirmezseniz mevcut görsel korunur.' : '' %></p>
        </div>
      </div>
    </div>
  </fieldset>

  <div class="lg:col-span-2">
    <label class="flex items-start gap-3 text-sm <%= featuredBlocked ? 'opacity-60' : '' %>">
      <input class="mt-0.5 h-4 w-4 accent-bronze" type="checkbox" name="is_featured" id="is_featured" <%= p.is_featured ? 'checked' : '' %> <%= featuredBlocked ? 'disabled' : '' %>>
      <span>Ana sayfada öne çıkar
        <span class="block text-xs text-muted">Ana sayfada en fazla <%= maxFeatured %> proje öne çıkarılabilir (şu an diğer projelerde: <%= featuredCount %>).<%= featuredBlocked ? ' Limit dolu; önce başka bir projenin öne çıkarmasını kaldırın.' : '' %></span>
      </span>
    </label>
    <%- err('is_featured') %>
  </div>

  <div class="flex flex-wrap gap-3 lg:col-span-2">
    <button type="submit" class="btn btn-dark"><%= isEdit ? 'Değişiklikleri Kaydet' : 'Projeyi Ekle' %></button>
    <a href="/admin/projeler" class="btn btn-outline">Vazgeç</a>
  </div>
</form>
<%- include('../partials/admin-footer') %>
