<%- include('../partials/head') %>
<body class="grid-blueprint flex min-h-screen items-center justify-center bg-ivory px-5 py-10">
<main id="icerik" class="w-full max-w-md">
  <div class="rounded-2xl border border-charcoal/10 bg-white p-8 shadow-xl sm:p-10">
    <div class="mb-8 text-center">
      <img src="<%= site.logo %>" alt="<%= site.name %>" width="64" height="64" class="mx-auto mb-5 h-16 w-16 rounded-full border border-charcoal/15 bg-white object-cover p-0.5 shadow-sm">
      <p class="eyebrow">Yönetim Paneli</p>
      <h1 class="display mt-2 text-3xl">Giriş Yapın</h1>
    </div>

    <% if (error) { %>
      <div class="mb-5 rounded-xl border border-red-700/30 bg-red-50 px-4 py-3 text-sm text-red-900" role="alert"><%= error %></div>
    <% } %>

    <form action="/login" method="post" class="space-y-5" novalidate>
      <%- csrfField() %>
      <div>
        <label class="label" for="username">Kullanıcı Adı</label>
        <input class="field" id="username" name="username" type="text" autocomplete="username" required autofocus maxlength="100" value="<%= username %>">
      </div>
      <div>
        <label class="label" for="password">Şifre</label>
        <input class="field" id="password" name="password" type="password" autocomplete="current-password" required maxlength="200">
      </div>
      <button type="submit" class="btn btn-dark w-full py-4">Giriş Yap</button>
    </form>
    <p class="mt-6 text-center"><a href="/" class="link-arrow">← Siteye Dön</a></p>
  </div>
</main>
</body>
</html>
