<%- include('../partials/head') %>
<body>
<%- include('../partials/navbar') %>
<% const materials = splitList(project.materials); %>

<main id="icerik" class="pt-20">
  <article>
    <header class="grid-blueprint border-b border-charcoal/10 pb-10 pt-12 sm:pt-16">
      <div class="container-x" data-stagger="70">
        <nav aria-label="Konum" class="reveal mb-8 text-[11px] uppercase tracking-arch text-muted">
          <a href="/" class="hover:text-bronze-dark">Ana Sayfa</a> <span aria-hidden="true">/</span>
          <a href="/projeler" class="hover:text-bronze-dark">Projeler</a> <span aria-hidden="true">/</span>
          <span class="text-charcoal" aria-current="page"><%= project.title %></span>
        </nav>
        <% if (project.category_label) { %><p class="eyebrow reveal mb-3"><%= project.category_label %></p><% } %>
        <h1 class="display reveal text-4xl sm:text-5xl lg:text-7xl" data-reveal="title"><%= project.title %></h1>
        <% const sub = [project.location, project.year].filter(Boolean).join(' • '); if (sub) { %>
          <p class="reveal mt-4 text-sm font-medium uppercase tracking-widest text-muted"><%= sub %></p>
        <% } %>
      </div>
    </header>

    <% if (project.image_url) { %>
      <div class="bg-ivory">
        <div class="container-x py-8 lg:py-12">
          <div class="overflow-hidden border border-charcoal/15 bg-bone p-2 shadow-xl sm:p-3">
            <div class="parallax-frame reveal aspect-[4/3] overflow-hidden sm:aspect-[16/9]" data-reveal="clip">
              <div class="parallax-media h-full w-full" data-parallax-media="18">
                <img src="<%= project.image_url %>" alt="<%= project.title %><%= project.location ? ' - ' + project.location : '' %>" fetchpriority="high" decoding="async" width="1600" height="1000" class="h-full w-full object-cover">
              </div>
            </div>
          </div>
        </div>
      </div>
    <% } %>

    <div class="bg-ivory pb-16 lg:pb-24">
      <div class="container-x grid gap-12 lg:grid-cols-12 lg:gap-16">
        <div class="lg:col-span-7" data-stagger="80">
          <% if (project.description) { %>
            <div class="reveal">
              <h2 class="mb-4 text-xs font-semibold uppercase tracking-widest text-charcoal">Konsept &amp; Tasarım Yaklaşımı</h2>
              <p class="whitespace-pre-line text-base font-light leading-relaxed text-muted sm:text-lg"><%= project.description %></p>
            </div>
          <% } %>
          <% if (materials.length) { %>
            <div class="reveal mt-12">
              <h2 class="mb-4 text-xs font-semibold uppercase tracking-widest text-charcoal">Kullanılan Ana Malzemeler</h2>
              <ul class="flex flex-wrap gap-2" data-stagger="45">
                <% materials.forEach((mat) => { %><li class="badge reveal"><%= mat %></li><% }) %>
              </ul>
            </div>
          <% } %>
        </div>

        <aside class="reveal lg:col-span-5" aria-label="Proje bilgileri" data-reveal="scale">
          <dl class="divide-y divide-charcoal/10 border border-charcoal/15 bg-bone" data-stagger="50">
            <% [
              ['Kategori', project.category_label],
              ['Lokasyon', project.location],
              ['Toplam Alan', project.area],
              ['Yıl', project.year],
              ['Mimari Ekip', project.architect]
            ].filter((row) => row[1]).forEach((row) => { %>
              <div class="reveal flex items-start justify-between gap-6 px-5 py-4 text-sm">
                <dt class="text-xs font-medium uppercase tracking-widest text-muted"><%= row[0] %></dt>
                <dd class="text-right font-medium text-charcoal"><%= row[1] %></dd>
              </div>
            <% }) %>
          </dl>
          <a href="/iletisim" class="btn btn-dark mt-6 w-full">Benzer Bir Proje İçin Görüşelim</a>
        </aside>
      </div>
    </div>
  </article>

  <% if (related.length) { %>
    <section class="section-y border-t border-charcoal/10 bg-bone">
      <div class="container-x">
        <div class="reveal mb-10 flex items-end justify-between gap-4">
          <h2 class="display text-3xl sm:text-4xl" data-reveal="title">Diğer Projeler</h2>
          <a href="/projeler" class="link-arrow">Tümü <span aria-hidden="true">→</span></a>
        </div>
        <div class="grid grid-cols-1 gap-6 md:grid-cols-3 lg:gap-8" data-stagger="80">
          <% related.forEach((p) => { %><div class="reveal"><%- include('../partials/project-card', { project: p }) %></div><% }) %>
        </div>
      </div>
    </section>
  <% } %>
</main>

<%- include('../partials/footer') %>
