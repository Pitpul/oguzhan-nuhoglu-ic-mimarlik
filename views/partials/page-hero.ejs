<%# İç sayfalar için editoryal başlık. Parametreler: eyebrow, title, accent, lead %>
<section class="grid-blueprint border-b border-charcoal/10 pt-32 pb-16 sm:pt-40 sm:pb-20 lg:pb-24">
  <div class="container-x">
    <div class="max-w-4xl" data-stagger="80">
      <div class="reveal mb-6 inline-flex items-center gap-2.5 rounded-full border border-charcoal/10 bg-bone/80 px-4 py-1.5">
        <span class="h-2 w-2 rounded-full bg-bronze"></span>
        <span class="text-[11px] font-medium uppercase tracking-wide-arch text-muted"><%= eyebrow %></span>
      </div>
      <h1 class="display reveal text-4xl sm:text-5xl lg:text-7xl" data-reveal="title">
        <%= title %><% if (locals.accent) { %> <span class="block italic font-normal text-bronze sm:inline"><%= accent %></span><% } %>
      </h1>
      <% if (locals.lead) { %><p class="reveal mt-6 max-w-2xl text-base font-light leading-relaxed text-muted sm:text-lg"><%= lead %></p><% } %>
    </div>
  </div>
</section>
