@tailwind base;
@tailwind components;
@tailwind utilities;

@layer base {
  html {
    scroll-behavior: smooth;
    -webkit-text-size-adjust: 100%;
    overflow-x: clip;
  }
  body {
    @apply flex min-h-screen flex-col bg-ivory font-sans text-charcoal antialiased;
    overflow-x: clip;
  }
  main {
    flex: 1 0 auto;
  }
  :focus-visible {
    outline: 2px solid theme('colors.bronze.DEFAULT');
    outline-offset: 3px;
  }
  ::selection {
    background-color: theme('colors.bronze.DEFAULT');
    color: theme('colors.bone');
  }
  [id] {
    scroll-margin-top: 5rem;
  }
}

@layer components {
  .container-x {
    @apply mx-auto w-full max-w-7xl px-5 sm:px-8 lg:px-12;
  }
  .section-y {
    @apply py-16 sm:py-20 lg:py-28;
  }
  .eyebrow {
    @apply text-[11px] font-medium uppercase tracking-wide-arch text-bronze-dark;
  }
  .display {
    @apply font-serif font-light leading-[1.1] tracking-tight text-charcoal;
  }

  /* Butonlar */
  .btn {
    @apply inline-flex items-center justify-center gap-2 rounded-full px-7 py-3.5 text-xs font-semibold uppercase tracking-arch transition-all duration-300;
  }
  .btn-dark {
    @apply bg-charcoal text-bone hover:bg-bronze;
  }
  .btn-outline {
    @apply border border-charcoal/30 text-charcoal hover:border-charcoal hover:bg-white/60;
  }
  .btn-sm {
    @apply px-5 py-2.5 text-[11px];
  }
  .btn-danger {
    @apply border border-red-800/30 text-red-800 hover:bg-red-800 hover:text-white;
  }
  .link-arrow {
    @apply inline-flex items-center gap-2 text-xs font-medium uppercase tracking-arch text-charcoal transition-colors hover:text-bronze-dark;
  }

  /* Form elemanları */
  .field {
    @apply w-full rounded-xl border border-charcoal/15 bg-bone px-4 py-3 text-sm text-charcoal transition-colors placeholder:text-muted/60 focus:border-bronze focus:outline-none;
  }
  .field[aria-invalid='true'] {
    @apply border-red-700;
  }
  .label {
    @apply mb-2 block text-[11px] font-medium uppercase tracking-wider text-muted;
  }
  .field-error {
    @apply mt-1.5 text-xs text-red-800;
  }

  /* Header */
  .site-header {
    @apply fixed inset-x-0 top-0 z-50 border-b border-charcoal/10 bg-ivory/85 backdrop-blur-md transition-shadow duration-300;
  }
  .site-header.is-scrolled {
    @apply bg-ivory/95 shadow-[0_10px_30px_-15px_rgba(26,25,23,0.25)];
  }
  .nav-link {
    @apply relative py-2 text-xs font-medium uppercase tracking-arch text-charcoal transition-colors hover:text-bronze-dark;
  }
  .nav-link[aria-current='page'] {
    @apply font-semibold text-bronze-dark;
  }
  .nav-link[aria-current='page']::after {
    content: '';
    @apply absolute inset-x-0 -bottom-0.5 h-px bg-bronze;
  }
  .mobile-drawer {
    @apply fixed inset-0 z-40 flex translate-x-full flex-col justify-between overflow-y-auto bg-bone px-6 pb-10 pt-28 transition-transform duration-300 lg:hidden;
  }
  .mobile-drawer.is-open {
    @apply translate-x-0;
  }

  /* Kartlar & yüzeyler */
  .grid-blueprint {
    background-size: 56px 56px;
    background-image: linear-gradient(to right, rgba(26, 25, 23, 0.04) 1px, transparent 1px),
      linear-gradient(to bottom, rgba(26, 25, 23, 0.04) 1px, transparent 1px);
  }
  .filter-btn {
    @apply border border-charcoal/15 px-4 py-2 text-[11px] font-medium uppercase tracking-arch text-charcoal/80 transition-all duration-300 hover:border-charcoal sm:px-5;
  }
  .filter-btn[aria-pressed='true'] {
    @apply border-charcoal bg-charcoal text-bone;
  }

  /* SSS akordeonu */
  .faq-panel {
    @apply grid grid-rows-[0fr] transition-all duration-300;
  }
  .faq-panel[data-open='true'] {
    @apply grid-rows-[1fr];
  }

  /* Scroll reveal: JS kapalıysa içerik her zaman görünür */
  .reveal {
    opacity: 0;
    transform: translateY(32px) scale(0.985);
    transition:
      opacity 0.95s cubic-bezier(0.16, 1, 0.3, 1),
      transform 0.95s cubic-bezier(0.16, 1, 0.3, 1);
    will-change: opacity, transform;
  }
  .reveal.is-visible {
    opacity: 1;
    transform: translate3d(0, 0, 0) scale(1);
  }

  /* ==========================================================================
     KATMANLI SCROLL ANİMASYONU (Sticky Layered Section Architecture)
     ========================================================================== */
  .scroll-stack {
    position: relative;
    isolation: isolate;
    z-index: 1;
    background-color: #1A1917;
  }

  .layer-section {
    position: relative;
    width: 100%;
    overflow: hidden;
    transform-origin: center top;
  }

  /* JS aktif olduğunda her bölüm dinamik sticky top değeriyle katmanlanır */
  .scroll-stack.is-layered > .layer-section {
    position: sticky;
    top: var(--sticky-top, 0px);
  }

  /* İlk bölümden (Hero) sonra gelen tüm bölümler üstteki bölümün üzerine gölge ve mimari pah ile biner */
  .layer-section + .layer-section {
    border-top: 1px solid rgba(158, 123, 86, 0.26);
    border-top-left-radius: 1.35rem;
    border-top-right-radius: 1.35rem;
    box-shadow:
      0 -24px 64px -14px rgba(20, 19, 17, 0.24),
      0 -3px 12px 0 rgba(20, 19, 17, 0.08);
  }

  @media (min-width: 768px) {
    .layer-section + .layer-section {
      border-top-left-radius: 2rem;
      border-top-right-radius: 2rem;
    }
  }

  .layer-inner {
    position: relative;
    z-index: 10;
    width: 100%;
    height: 100%;
    transform-origin: center 20%;
    will-change: transform, opacity;
  }

  /* Üst katman gelirken arka planda kalan bölümü yumuşakça karartan derinlik perdesi */
  .layer-veil {
    position: absolute;
    inset: 0;
    z-index: 25;
    pointer-events: none;
    background: linear-gradient(180deg, rgba(26, 25, 23, 0.25) 0%, rgba(26, 25, 23, 0.65) 100%);
    opacity: 0;
    will-change: opacity;
  }

  /* Görsel derinlik ve parallax çerçevesi */
  .parallax-frame {
    position: relative;
    overflow: hidden;
  }
  .parallax-media {
    will-change: transform;
    transform: translate3d(0, var(--parallax-y, 0px), 0) scale(var(--parallax-scale, 1.07));
    transition: transform 0.12s linear;
  }

  /* Admin paneli */
  .admin-card {
    @apply rounded-2xl border border-charcoal/10 bg-white p-5 shadow-sm sm:p-6;
  }
  .admin-nav-link {
    @apply rounded-full px-4 py-2 text-xs font-medium uppercase tracking-arch text-muted transition-colors hover:text-charcoal;
  }
  .admin-nav-link[aria-current='page'] {
    @apply bg-charcoal text-bone;
  }
  .badge {
    @apply inline-flex items-center rounded-full border border-charcoal/15 bg-bone px-3 py-1 text-[11px] font-medium text-muted;
  }
}

@media (scripting: none) {
  .reveal {
    opacity: 1;
    transform: none;
  }
}

@media (prefers-reduced-motion: reduce) {
  html {
    scroll-behavior: auto;
  }
  .reveal {
    opacity: 1;
    transform: none;
    transition: none;
  }
  .scroll-stack.is-layered > .layer-section {
    position: relative;
    top: auto;
  }
  .layer-inner,
  .parallax-media {
    transform: none !important;
  }
  .layer-veil {
    opacity: 0 !important;
  }
  *,
  *::before,
  *::after {
    animation-duration: 0.01ms !important;
    animation-iteration-count: 1 !important;
    transition-duration: 0.01ms !important;
  }
}
